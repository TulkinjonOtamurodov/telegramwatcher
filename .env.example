# MAKIMA Telegram watcher - environment template.
#
# Copy this file to .env and fill it in. .env is git-ignored and must NEVER be
# committed. On a server, create it directly on the box:
#
#     cp .env.example .env && nano .env
#
# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# From https://my.telegram.org -> API development tools.
# api_id is a number, api_hash is 32 hex characters.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Your personal account's phone number, international format (+15551234567).
# Used only by `python -m app.auth_user` to request the login code.
TELEGRAM_PHONE=

# Token for the private alert bot, from @BotFather (/newbot or /mybots).
TELEGRAM_BOT_TOKEN=

# Numeric Telegram user IDs allowed to control the bot and receive alerts,
# comma separated: ADMIN_USER_IDS=12345678,87654321
# Leave empty to default to the account the watcher signs in as.
# Tip: send any command to the bot; an unauthorised reply tells you your ID.
ADMIN_USER_IDS=

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# Log verbosity for MAKIMA's own messages: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Telethon's internal logger. Keep at WARNING unless debugging connectivity.
TELETHON_LOG_LEVEL=WARNING

# Override storage locations. Defaults are ./data, ./sessions and ./logs,
# which is what docker-compose.yml mounts as volumes.
#MAKIMA_DATA_DIR=
#MAKIMA_SESSIONS_DIR=
#MAKIMA_LOGS_DIR=

# ---------------------------------------------------------------------------
# FUTURE AI CLASSIFICATION (not required - the watcher runs fine without it)
# ---------------------------------------------------------------------------
# Turn classification on in data/watcher_settings.json ("ai": {"enabled": true}).
# Without a registered backend a free rule-based classifier is used; these
# variables are read by whatever backend you plug into app/ai_classifier.py.
#AI_PROVIDER=
#AI_API_KEY=
#AI_MODEL=

# ---------------------------------------------------------------------------
# FUEL AUTOMATION (optional; off unless explicitly enabled)
# ---------------------------------------------------------------------------
# Detects load confirmations in mapped groups, computes a fuel deadline, and
# reminds you until you press ARRANGED. Leave false to keep MAKIMA unchanged.
FUEL_AUTOMATION_ENABLED=false

# FuelHelper's API, reachable from inside MAKIMA's container. If both stacks
# run on the same VPS in separate compose projects, Docker service DNS does not
# resolve across them -- use the host-reachable address instead.
#FUELHELPER_API_URL=http://host.docker.internal:4173
# Must equal FUEL_API_KEY in /opt/fuelhelper/.env. Never commit the real value.
#FUELHELPER_API_TOKEN=

# Hours before pickup that fuel must be arranged, and how often to remind.
FUEL_DEADLINE_HOURS_BEFORE_PICKUP=3
FUEL_REMINDER_INTERVAL_MINUTES=60
