{
  "watching": {
    "mentions": true,
    "replies": true,
    "keywords": true
  },
  "alerts": {
    "include_message_text": true,
    "max_message_chars": 500,
    "max_keyword_preview": 8,
    "template": "{{tags}}\n\n🔴 LOOK AT THIS.\n{{triggers}}\n\n👤 {{sender}}\n🏢 {{group}}\n\n{{message_block}}\n\n⚠️ DON'T LEAVE IT UNATTENDED."
  },
  "formatting": {
    "timestamp_format": "%Y-%m-%d %H:%M:%S UTC"
  },
  "ai": {
    "enabled": false
  }
}
